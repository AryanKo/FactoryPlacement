# Google Maps JavaScript API Key (required for live Google Maps rendering, Places Autocomplete & Geocoding)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API Base URL - FastAPI server address (default: http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api

# Mock mode: set to "true" for offline-only demo (no backend needed), "false" or omit for real GEE + Gemma 4
VITE_USE_MOCK_API=false
