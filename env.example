# Copy to .env and fill in. Never commit the real .env file.

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- Gemma 4 ---
